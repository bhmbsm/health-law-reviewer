<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <application android:allowBackup="true" android:label="보건법규 심사관" android:theme="@style/AppTheme">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <receiver android:name=".ReviewWidgetProvider" android:exported="true" android:label="오늘의 보건법규 심사">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="kr.capstone.healthlaw.WIDGET_UPDATED"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/review_widget_info"/>
    </receiver>
  </application>
</manifest>
